model Cart {
  cart_id     String   @id @default(uuid())
  medicine_id String
  customer_id String
  quantity    Int
  addedAt     DateTime @default(now())

  medicineRelation Medicines @relation(fields: [medicine_id], references: [medicine_id], onDelete: Cascade)
  customerRelation User      @relation(fields: [customer_id], references: [id], onDelete: Cascade)

  @@unique([customer_id, medicine_id])
  @@index([medicine_id])
  @@index([customer_id])
  @@map("cart")
}
