model OrderItems {
  order_item_id String @id @default(uuid())
  order_id      String
  medicine_id   String
  quantity      Int
  price         Int // price at time of order

  orderRelation    Orders    @relation(fields: [order_id], references: [order_id], onDelete: Cascade)
  medicineRelation Medicines @relation(fields: [medicine_id], references: [medicine_id], onDelete: Cascade)

  @@index([order_id])
  @@index([medicine_id])
  @@map("order_items")
}
