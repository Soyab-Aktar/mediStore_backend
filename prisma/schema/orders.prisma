model Orders {
  order_id        String         @id @default(uuid())
  customer_id     String
  medicine_id     String
  quantity        Int
  price           Int
  totalAmount     Int
  status          OrderStatus    @default(PLACED)
  shippingAddress String         @db.Text
  paymentMethod   PaymentMethods @default(CASH_ON_DELIVERY)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  customer User      @relation(fields: [customer_id], references: [id])
  medicine Medicines @relation(fields: [medicine_id], references: [medicine_id])

  @@index([customer_id])
  @@index([medicine_id])
  @@map("orders")
}

enum OrderStatus {
  PLACED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentMethods {
  CASH_ON_DELIVERY
}
